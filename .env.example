# Discord Bot Token (from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Channel ID where announcements and reminders will be posted
CHANNEL_ID=your_target_channel_id_here

# Timezone (e.g. Asia/Kolkata, UTC, America/New_York)
TIMEZONE=Asia/Kolkata

# 8:00 AM Challenge Announcement
MORNING_HOUR=8
MORNING_MINUTE=0

# 1:00 PM Midday Check-In
AFTERNOON_HOUR=13
AFTERNOON_MINUTE=0

# 8:30 PM Evening Reminder
EVENING_HOUR=20
EVENING_MINUTE=30
